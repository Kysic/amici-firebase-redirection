{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/collecte",
        "destination": "/collecte.html"
      },
      {
        "source": "/web",
        "destination": "/web.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
